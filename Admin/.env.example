# Supabase Configuration for Admin Dashboard
# Obtain your Project URL and Anon/Publishable API Key from Supabase Dashboard -> Project Settings -> API
# Example URL format: https://yourprojectref.supabase.co
# Example Key format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
